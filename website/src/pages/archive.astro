---
import { getCollection } from 'astro:content';
import NewspaperLayout from '../layouts/NewspaperLayout.astro';
import ArchiveList from '../components/ArchiveList.astro';

const allEditions = await getCollection('editions');
const sortedEditions = allEditions.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<NewspaperLayout
  title="Archive"
  description="Browse all past editions of Powai Daily — your hyperlocal morning brief for Powai & Mumbai."
>
  <div class="container-wide pt-12 pb-6 fade-in">
    <h1 class="mb-3" style="font-family: 'Playfair Display', Georgia, serif; font-weight: 800; font-style: italic;">
      The Archive
    </h1>
    <p class="text-[1rem] text-[var(--color-ink-muted)] mb-6">
      Browse past editions of Powai Daily.
    </p>
    <hr class="rule mb-8" />
  </div>

  <div class="container-wide pb-16">
    <ArchiveList editions={sortedEditions} />
  </div>
</NewspaperLayout>
