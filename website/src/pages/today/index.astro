---
import { getCollection } from 'astro:content';
import NewspaperLayout from '../../layouts/NewspaperLayout.astro';
import EditionView from '../../components/EditionView.astro';

// Get all editions and sort by date (newest first)
const allEditions = await getCollection('editions');
const sortedEditions = allEditions.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Get the latest edition
const latestEdition = sortedEditions[0];

// If no editions exist, redirect to archive
if (!latestEdition) {
  return Astro.redirect('/archive');
}

const { data } = latestEdition;
---

<NewspaperLayout
  title={data.title}
  date={data.date}
  description={`${data.title} — Your ${data.readTime}-minute morning brief for Powai & Mumbai.`}
>
  <EditionView edition={latestEdition} isToday={true} />
</NewspaperLayout>
