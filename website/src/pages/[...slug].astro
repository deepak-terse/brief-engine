---
import { getCollection } from 'astro:content';
import NewspaperLayout from '../layouts/NewspaperLayout.astro';
import EditionHero from '../components/EditionHero.astro';
import SectionBlock from '../components/SectionBlock.astro';
import SubscribeCard from '../components/SubscribeCard.astro';

export async function getStaticPaths() {
  const editions = await getCollection('editions');
  return editions.map((edition) => {
    // edition.id is like "powai_morning_edition/2026-05-16"
    // or just "2026-05-16" for flat files
    const idParts = edition.id.split('/');
    const slug = idParts.length > 1
      ? idParts.join('/')           // edition_key/date
      : edition.data.date;          // fallback to date only

    return {
      params: { slug },
      props: { edition },
    };
  });
}

const { edition } = Astro.props;
const { data } = edition;

// Split sections for mid-page subscribe insert
const midPoint = Math.ceil(data.sections.length / 2);
const firstHalf = data.sections.slice(0, midPoint);
const secondHalf = data.sections.slice(midPoint);
---

<NewspaperLayout
  title={data.title}
  date={data.date}
  readTime={data.readTime}
  description={`${data.title} — Your ${data.readTime}-minute morning brief for Powai & Mumbai.`}
>
  <EditionHero title={data.title} date={data.date} readTime={data.readTime} />

  {firstHalf.map((section) => (
    <SectionBlock id={section.id} title={section.title} items={section.items} />
  ))}

  <!-- Mid-page subscribe card -->
  <SubscribeCard />

  {secondHalf.map((section) => (
    <SectionBlock id={section.id} title={section.title} items={section.items} />
  ))}

  <!-- End of edition -->
  <div class="container-reading py-10">
    <hr class="rule mb-6" />
    <div class="flex items-center justify-between meta-text">
      <p>End of edition</p>
      <a href="/archive" class="font-sans text-sm font-semibold text-[var(--color-ink)] hover:text-[var(--color-navy)] transition-colors">
        ← Browse all editions
      </a>
    </div>
  </div>
</NewspaperLayout>
