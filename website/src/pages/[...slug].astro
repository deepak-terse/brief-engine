---
import { getCollection } from 'astro:content';
import NewspaperLayout from '../layouts/NewspaperLayout.astro';
import EditionView from '../components/EditionView.astro';

export async function getStaticPaths() {
  const editions = await getCollection('editions');
  return editions.map((edition) => {
    const idParts = edition.id.split('/');
    const slug = idParts.length > 1 ? idParts.join('/') : edition.data.date;
    return {
      params: { slug },
      props: { edition },
    };
  });
}

const { edition } = Astro.props;
const { data } = edition;
---

<NewspaperLayout
  title={data.title}
  date={data.date}
  description={`${data.title} — Your ${data.readTime}-minute morning brief for Powai & Mumbai.`}
>
  <EditionView edition={edition} />
</NewspaperLayout>
