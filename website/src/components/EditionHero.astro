---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  date: string;
  readTime: number;
}

const { title, date, readTime } = Astro.props;
---

<section class="container-reading pt-10 pb-8 fade-in" id="edition-hero">
  <hr class="rule-double mb-6" />
  <h1 class="text-[var(--color-ink)] mb-3 leading-tight">
    {title}
  </h1>
  <div class="flex items-center gap-3 meta-text">
    <time datetime={date}>{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{readTime} min read</span>
  </div>
  <hr class="rule mt-6" />
</section>
