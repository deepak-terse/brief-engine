---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  date: string;
  readTime: number;
  subtitle?: string;
}

const { title, date, readTime, subtitle } = Astro.props;

// Format as "Saturday, May 16" style
const d = new Date(date + 'T00:00:00');
const dayName = d.toLocaleDateString('en-IN', { weekday: 'long' });
const monthDay = d.toLocaleDateString('en-IN', { month: 'long', day: 'numeric' });
const displayDate = `${dayName}, ${monthDay}`;

// Format for pill: "MAY 16, 2026"
const pillDate = d.toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase();
---

<section class="container-reading pt-12 pb-8 text-center fade-in" id="edition-hero">
  <!-- Date + read time pill -->
  <div class="mb-6">
    <span class="pill">
      {pillDate} · {readTime} MIN READ
    </span>
  </div>

  <!-- Large display date -->
  <h1 class="text-[clamp(2.5rem,6vw,4rem)] mb-4" style="font-family: 'Playfair Display', Georgia, serif; font-weight: 800; font-style: italic;">
    {displayDate}
  </h1>

  <!-- Subtitle — personalized greeting or default -->
  <p class="text-[1rem] text-[var(--color-ink-faint)] italic mb-8" style="font-family: var(--font-serif);">
    {subtitle || 'The daily hyperlocal briefing for Powai, Mumbai.'}
  </p>

  <hr class="rule" />
</section>
