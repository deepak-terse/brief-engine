---
import { formatDate } from '../utils/date';

interface Edition {
  id: string;
  data: {
    title: string;
    date: string;
    readTime: number;
    editionKey: string;
  };
}

interface Props {
  editions: Edition[];
}

const { editions } = Astro.props;

function editionHref(edition: Edition): string {
  // id is "powai_morning_edition/2026-05-16" or just "2026-05-16"
  return `/${edition.id}`;
}
---

<div class="space-y-0" id="archive-list">
  {editions.length === 0 ? (
    <div class="py-16 text-center">
      <p class="text-[var(--color-ink-muted)] text-lg">No editions yet.</p>
      <p class="meta-text mt-2">Check back soon for your first daily brief.</p>
    </div>
  ) : (
    editions.map((edition) => (
      <a
        href={editionHref(edition)}
        class="block py-4 border-b border-[var(--color-rule-light)] hover:bg-[var(--color-paper-warm)] transition-colors -mx-4 px-4 rounded-sm no-underline group"
        id={`archive-item-${edition.data.date}`}
      >
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0">
            <h3 class="text-[1rem] font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors leading-snug mb-1">
              {edition.data.title}
            </h3>
            <time class="meta-text" datetime={edition.data.date}>
              {formatDate(edition.data.date, true)}
            </time>
            <span class="meta-text text-[var(--color-ink-faint)]">·</span>
            <span class="meta-text text-[var(--color-ink-faint)]">{edition.data.editionKey}</span>
          </div>
          <span class="meta-text whitespace-nowrap shrink-0 mt-1">
            {edition.data.readTime} min
          </span>
        </div>
      </a>
    ))
  )}
</div>
