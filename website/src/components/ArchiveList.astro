---
import { formatDisplayDate, formatPillDate } from '../utils/date';

interface Edition {
  id: string;
  data: {
    title: string;
    date: string;
    readTime: number;
    editionKey: string;
  };
}

interface Props {
  editions: Edition[];
}

const { editions } = Astro.props;

function editionHref(edition: Edition): string {
  return `/${edition.id}`;
}
---

<div class="space-y-4" id="archive-list">
  {editions.length === 0 ? (
    <div class="py-16 text-center">
      <p class="text-[var(--color-ink-muted)] text-lg">No editions yet.</p>
      <p class="meta-text mt-2">Check back soon for your first daily brief.</p>
    </div>
  ) : (
    editions.map((edition) => (
      <a
        href={editionHref(edition)}
        class="archive-card block no-underline group"
        id={`archive-item-${edition.data.date}`}
      >
        <div class="flex items-center gap-3 mb-2">
          <span class="meta-text flex items-center gap-1.5">
            <span aria-hidden="true">📅</span>
            {formatPillDate(edition.data.date)}
          </span>
          <span class="meta-text">•</span>
          <span class="meta-text flex items-center gap-1.5">
            <span aria-hidden="true">🕐</span>
            {edition.data.readTime} MIN READ
          </span>
        </div>
        <h3 class="text-[1.25rem] font-bold group-hover:text-[var(--color-navy)] transition-colors leading-snug"
          style="font-family: 'Playfair Display', Georgia, serif; font-style: italic;">
          {formatDisplayDate(edition.data.date)}
        </h3>
      </a>
    ))
  )}
</div>
