---
interface Props {
  title: string;
  summary?: string;
}

const { title, summary } = Astro.props;
---

<article class="py-4">
  <h3 class="text-[1.1rem] font-bold leading-snug text-[var(--color-ink)] mb-2">
    {title}
  </h3>
  {summary && (
    <p class="text-[0.95rem] leading-[1.75] text-[var(--color-ink-light)]">
      {summary}
    </p>
  )}
</article>
