---
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50">
  <!-- Navy accent stripe -->
  <div class="h-1 bg-[var(--color-navy)]"></div>

  <!-- Main header bar -->
  <div class="bg-white/95 backdrop-blur-sm border-b border-[var(--color-rule)]">
    <div class="container-full">
      <div class="flex items-center justify-between py-4">
        <a href="/" class="no-underline hover:opacity-80 transition-opacity" id="header-logo">
          <span class="font-[var(--font-display)] text-xl font-bold italic text-[var(--color-ink)]"
            style="font-family: 'Playfair Display', Georgia, serif;">
            Powai Daily
          </span>
        </a>
        <nav class="flex items-center gap-6" id="header-nav">
          <a
            href="/today"
            class:list={[
              'font-sans text-sm font-medium transition-colors',
              currentPath === '/today' || currentPath === '/today/' ? 'text-[var(--color-ink)] font-semibold' : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]',
            ]}
            id="nav-today"
          >
            Today's Edition
          </a>
          <a
            href="/archive"
            class:list={[
              'font-sans text-sm font-medium transition-colors',
              currentPath === '/archive' || currentPath === '/archive/' ? 'text-[var(--color-ink)] font-semibold' : 'text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]',
            ]}
            id="nav-archive"
          >
            Archive
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>
