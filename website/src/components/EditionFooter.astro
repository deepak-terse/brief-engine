---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-rule)] mt-auto">
  <div class="container-reading py-8">
    <hr class="rule-double mb-6" />
    <div class="text-center space-y-3">
      <p class="font-sans text-xs font-semibold tracking-[0.12em] uppercase text-[var(--color-ink-muted)]">
        Powai Daily
      </p>
      <p class="meta-text">
        Hyperlocal news for Powai & Mumbai.<br />
        Curated to respect your time.
      </p>
      <p class="meta-text text-[var(--color-ink-faint)]">
        &copy; {year} Powai Daily. All rights reserved.
      </p>
    </div>
  </div>
</footer>
