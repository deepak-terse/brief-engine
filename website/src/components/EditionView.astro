---
import EditionHero from './EditionHero.astro';
import SectionBlock from './SectionBlock.astro';
import SubscribeCard from './SubscribeCard.astro';

interface Props {
  edition: {
    data: {
      title: string;
      subtitle?: string;
      date: string;
      readTime: number;
      sections: Array<{
        id: string;
        title: string;
        description?: string;
        scope_label?: string;
        items: any[];
      }>;
    };
  };
  isToday?: boolean;
}

const { edition, isToday = false } = Astro.props;
const { data } = edition;

// Split sections at midpoint for mid-page newsletter signup injection
const midPoint = Math.ceil(data.sections.length / 2);
const firstHalf = data.sections.slice(0, midPoint);
const secondHalf = data.sections.slice(midPoint);
---

<EditionHero
  title={data.title}
  date={data.date}
  readTime={data.readTime}
  subtitle={data.subtitle}
/>

{firstHalf.map((section) => (
  <SectionBlock
    id={section.id}
    title={section.title}
    description={section.description}
    scopeLabel={section.scope_label}
    items={section.items}
  />
))}

<SubscribeCard />

{secondHalf.map((section) => (
  <SectionBlock
    id={section.id}
    title={section.title}
    description={section.description}
    scopeLabel={section.scope_label}
    items={section.items}
  />
))}

<div class="container-reading py-10">
  <hr class="rule mb-6" />
  {isToday ? (
    <div class="text-center">
      <p class="meta-text mb-3">
        That's your brief for today. Have a calm, productive day.
      </p>
      <a href="/archive" class="inline-flex items-center gap-2 font-sans text-sm font-semibold text-[var(--color-ink)] hover:text-[var(--color-navy)] transition-colors">
        Browse past editions <span aria-hidden="true">→</span>
      </a>
    </div>
  ) : (
    <div class="flex items-center justify-between meta-text">
      <p>End of edition</p>
      <a href="/archive" class="font-sans text-sm font-semibold text-[var(--color-ink)] hover:text-[var(--color-navy)] transition-colors">
        ← Browse all editions
      </a>
    </div>
  )}
</div>
