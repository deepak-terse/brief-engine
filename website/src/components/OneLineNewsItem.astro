---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<article class="py-2">
  <p class="text-[1rem] leading-[1.75] text-[var(--color-ink)] flex items-start gap-3">
    <span class="text-[var(--color-ink-faint)] mt-[0.35rem] shrink-0 text-lg" aria-hidden="true">•</span>
    <span class="font-semibold">{title}</span>
  </p>
</article>
