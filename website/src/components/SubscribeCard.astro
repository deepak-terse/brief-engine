    <h3 class="text-[1.4rem] mb-2" style="font-family: 'Playfair Display', Georgia, serif; font-weight: 700;">
      Get tomorrow's briefing
    </h3>
    <p class="text-[0.9rem] text-[var(--color-ink-muted)] mb-5">
