---
interface Props {
  title: string;
  brief?: string;
  whyItMatters?: string;
}

const { title, brief, whyItMatters } = Astro.props;
---

<article class="py-5">
  <h3 class="text-[1.15rem] font-bold leading-snug text-[var(--color-ink)] mb-3">
    {title}
  </h3>

  {brief && (
    <p class="text-[0.95rem] leading-[1.75] text-[var(--color-ink-light)] mb-3">
      {brief}
    </p>
  )}

  {whyItMatters && (
    <div class="callout-why">
      <p class="callout-label">WHY IT MATTERS</p>
      <p class="text-[0.9rem] leading-relaxed text-[var(--color-ink-light)]">
        {whyItMatters}
      </p>
    </div>
  )}
</article>
