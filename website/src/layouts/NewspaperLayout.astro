---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import EditionFooter from '../components/EditionFooter.astro';

interface Props {
  title: string;
  description?: string;
  date?: string;
}

const { title, description, date } = Astro.props;
---

<BaseLayout title={title} description={description} date={date}>
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <EditionFooter />
</BaseLayout>
